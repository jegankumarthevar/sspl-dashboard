{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R4 discovery paper envelope with preserved legacy experiment",
  "type": "object",
  "required": [
    "schema",
    "engine",
    "engineState",
    "events",
    "testEvents",
    "processedRuns",
    "lastRun",
    "relay",
    "summary"
  ],
  "properties": {
    "schema": {
      "enum": [
        1,
        2
      ]
    },
    "engine": {
      "enum": [
        "R2.3-exact-core",
        "R3.1-limit-minus20",
        "R3.2-strict-evidence-limit-minus20",
        "R3.3-ungated4-recorded-limit-minus20",
        "R4-discovery-paper-500-10-50-hold"
      ]
    },
    "engineState": {
      "type": "object",
      "description": "Runtime uses original schema3 plus continuous ledger validation and cash reconciliation.",
      "required": [
        "schema",
        "tokens",
        "settings",
        "portfolio",
        "autoPaper"
      ],
      "properties": {
        "schema": {
          "const": 3
        },
        "autoPaper": {
          "type": "object",
          "required": [
            "version",
            "start",
            "entry",
            "maxPositions",
            "cash",
            "positions",
            "trades",
            "seen",
            "realized"
          ],
          "properties": {
            "version": {
              "const": "continuous-paper-1"
            },
            "start": {
              "const": 200
            },
            "entry": {
              "const": 20
            },
            "maxPositions": {
              "const": 6
            },
            "cash": {
              "type": "number",
              "minimum": 0
            },
            "positions": {
              "type": "array",
              "maxItems": 6
            },
            "trades": {
              "type": "array"
            },
            "seen": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "realized": {
              "type": "number"
            }
          }
        },
        "discoveryPaper": {
          "type": "object",
          "required": [
            "version",
            "start",
            "entry",
            "maxPositions",
            "cash",
            "positions",
            "trades",
            "seen",
            "realized",
            "stopRatio",
            "takeProfit"
          ],
          "properties": {
            "version": {
              "const": "discovery-paper-500-10-50-v1"
            },
            "start": {
              "const": 500
            },
            "entry": {
              "const": 10
            },
            "maxPositions": {
              "const": 50
            },
            "stopRatio": {
              "const": 0.5
            },
            "takeProfit": {
              "type": "null"
            },
            "cash": {
              "type": "number",
              "minimum": 0
            },
            "positions": {
              "type": "array",
              "maxItems": 50
            },
            "trades": {
              "type": "array"
            },
            "outcomes": {
              "type": "object"
            },
            "seen": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "realized": {
              "type": "number"
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "testEvents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "processedRuns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lastRun": {
      "type": [
        "object",
        "null"
      ]
    },
    "relay": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": [
        "id",
        "paper",
        "coin",
        "mint",
        "side",
        "entry",
        "exit",
        "pnl",
        "timestamp",
        "reason",
        "delivery",
        "attempts"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "paper": {
          "const": true
        },
        "coin": {
          "type": "string"
        },
        "mint": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        },
        "side": {
          "enum": [
            "BUY",
            "SELL",
            "LIMIT_PLACED",
            "ORDER_EXPIRED"
          ]
        },
        "entry": {
          "type": [
            "number",
            "null"
          ]
        },
        "exit": {
          "type": [
            "number",
            "null"
          ]
        },
        "pnl": {
          "type": [
            "number",
            "null"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        },
        "delivery": {
          "enum": [
            "PENDING",
            "ATTEMPTING",
            "PENDING_RETRY",
            "RELAY_ACCEPTED",
            "LEDGER_COMMITTED",
            "EXPIRED_TRANSPORT_REMOVED"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "eventType": {
          "enum": [
            "LIMIT_PLACED",
            "BUY",
            "SELL",
            "ORDER_EXPIRED"
          ]
        },
        "signalPrice": {
          "type": [
            "number",
            "null"
          ]
        },
        "limitPrice": {
          "type": [
            "number",
            "null"
          ]
        },
        "links": {
          "type": "object",
          "required": [
            "dexscreener",
            "gmgn",
            "solscan",
            "binance"
          ],
          "properties": {
            "dexscreener": {
              "type": [
                "string",
                "null"
              ]
            },
            "gmgn": {
              "type": [
                "string",
                "null"
              ]
            },
            "solscan": {
              "type": [
                "string",
                "null"
              ]
            },
            "binance": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "engine": {
            "const": "R4-discovery-paper-500-10-50-hold"
          }
        }
      },
      "then": {
        "properties": {
          "engineState": {
            "required": [
              "discoveryPaper"
            ]
          }
        }
      }
    }
  ]
}
